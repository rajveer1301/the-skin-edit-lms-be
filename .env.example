# Copy to .env and adjust for your environment
DATABASE_URL="postgresql://skinedit:skinedit@localhost:5432/skinedit?schema=public"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:4200"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (for "Continue with Google" login).
# When set, Google ID tokens are cryptographically verified against this client ID.
# Leave empty in local/demo environments to decode tokens without verification.
GOOGLE_CLIENT_ID=""
