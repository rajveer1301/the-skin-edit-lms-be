# Copy to .env and adjust for your environment
DATABASE_URL="postgresql://skinedit:skinedit@localhost:5432/skinedit?schema=public"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:4200"
PUBLIC_API_URL="http://localhost:3000/api"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth (for "Continue with Google" login).
# When set, Google ID tokens are cryptographically verified against this client ID.
# Leave empty to disable Google sign-in. Only existing active staff can sign in.
# Use the Web client ID. Add other OAuth clients after commas when they can sign in
# (e.g. a separate dev Web client, iOS client ID — not the Android SHA-1 client):
# GOOGLE_CLIENT_ID="PROD_WEB_CLIENT_ID,DEV_WEB_CLIENT_ID,IOS_CLIENT_ID"
# Do not put the Android OAuth client ID here (that one is SHA-1 only).
GOOGLE_CLIENT_ID=""

# Cloudflare R2 for consent scans, treatment photos, and other documents.
# In development, empty R2 credentials use signed links to ./storage.
# Production requires R2 unless ALLOW_LOCAL_STORAGE=true with a persistent volume.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="the-skin-edit-lms"
LOCAL_STORAGE_DIR="storage"
ALLOW_LOCAL_STORAGE="false"
# Defaults to JWT_ACCESS_SECRET when omitted.
FILE_SIGNING_SECRET=""
CLINIC_TIMEZONE="Asia/Kolkata"

# Google Drive nightly sync (patient documents + treatment before/after photos).
# Create a Google Cloud Service Account, download its JSON key, and share your
# Drive folder with the service account's email (Editor access). Then set:
#   GOOGLE_SERVICE_ACCOUNT_KEY   - the full JSON key contents, as a single-line string
#   GOOGLE_DRIVE_ROOT_FOLDER_ID  - the id of the shared Drive folder (from its URL)
# Leave both blank to disable the sync (it will just log a warning and skip).
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID="0AKl-TKmlcS-JUk9PVA"
